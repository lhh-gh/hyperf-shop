APP_NAME=skeleton
APP_ENV=dev

DB_DRIVER=mysql
DB_HOST=mysql80
DB_PORT=3306
DB_DATABASE=hyperf_shop
DB_USERNAME=hyperf_shop
# 填写本地创建的项目专用账号密码，不要提交真实密码。
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=redis62
# 填写现有 Redis 服务密码；无密码的服务使用 (null)。
REDIS_AUTH=
REDIS_PORT=6379
REDIS_DB=5
